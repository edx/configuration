Unattended-Upgrade::Package-Blacklist{
	{% for blacklisted_item in SECURITY_DEBIAN_PKGS_BLACKLIST %}
	  {{ blacklisted_item }};
	{% endfor %}
}

// Without a --force-conf* option unattended-upgrade refuses to upgrade any
// package whose conffile was modified locally ("has conffile prompt and needs
// to be upgraded manually"). Keep the local conffile and take the package
// maintainer's default where there is no local change.
Dpkg::Options {
	"--force-confdef";
	"--force-confold";
};
